{
  "manifest_version": 3,
  "name": "Loop to Markdown",
  "version": "1.0.0",
  "description": "Exporte une page Microsoft Loop en Markdown, pour la donner en contexte à vos agents IA.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Exporter la page en Markdown",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://loop.cloud.microsoft/*",
    "https://*.loop.cloud.microsoft/*",
    "https://loop.microsoft.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Exporter la page en Markdown"
    }
  }
}
